    },
    {
      "id": "should-trigger-02",
      "type": "should_trigger",
      "prompt": "给'玄武门之变'加个黑话词",
      "expected_behavior": "调用 technique-decay",
      "notes": "正面：加降维词"
    },
    {
      "id": "should-trigger-03",
      "type": "should_trigger",
      "prompt": "把'三国争霸'用网络语讲出来",
      "expected_behavior": "调用 technique-decay",
      "notes": "正面：网络语讲历史"
    },
    {
      "id": "should-not-trigger-01",
      "type": "should_not_trigger",
      "prompt": "解释一下商鞅变法的核心内容是什么",
